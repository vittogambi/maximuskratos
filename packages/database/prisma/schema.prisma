generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role                 @default(USER)
  onboardingStep      String               @default("TERMS_PENDING") @map("onboarding_step")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  diagnosticSession   DiagnosticSession?
  masterProfile       MasterProfile?
  userAchievements    UserAchievement[]

  @@map("users")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  mpCustomerId       String?            @map("mp_customer_id")
  mpSubscriptionId   String?            @map("mp_subscription_id")
  status             SubscriptionStatus @default(TRIAL)
  trialEnd           DateTime?          @map("trial_end")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Lead {
  id        String   @id @default(uuid())
  email     String
  name      String?
  message   String?
  source    String?  @default("contact")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── DIAGNÓSTICO MAESTRO ───────────────────────────────────────────────────────

enum DiagnosticPhase {
  FASE1
  FASE2
  FASE3
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SCALE_1_5
  FREE_TEXT
  RANKING
}

enum ScaleType {
  BEHAVIORAL
  FREQUENCY
}

enum ModuleStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  ALTO_AUTOENGANO
  INCONGRUENCIA_NARRATIVA
  RIESGO_FINANCIERO
  RIESGO_ABANDONO
  FALTA_PROPOSITO
  ENTORNO_TOXICO
  BAJA_EJECUCION
  SOBRECONFIANZA
  RESPUESTAS_INCONSISTENTES
}

model DiagnosticVersion {
  id          String             @id @default(uuid())
  version     String             @unique
  isActive    Boolean            @default(false) @map("is_active")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  modules     DiagnosticModule[]
  rules       Rule[]
  sessions    DiagnosticSession[]

  @@map("diagnostic_versions")
}

model DiagnosticModule {
  id               String              @id @default(uuid())
  versionId        String              @map("version_id")
  version          DiagnosticVersion   @relation(fields: [versionId], references: [id])
  phase            DiagnosticPhase
  dimensionKey     String              @map("dimension_key")
  slug             String
  order            Int
  titleEs          String              @map("title_es")
  introEs          String              @map("intro_es")
  outroTemplateEs  String              @map("outro_template_es")
  iconKey          String?             @map("icon_key")
  estimatedMinutes Int                 @map("estimated_minutes")
  isConditional    Boolean             @default(false) @map("is_conditional")
  questions        Question[]
  moduleProgress   UserModuleProgress[]

  @@unique([versionId, slug])
  @@index([phase])
  @@map("diagnostic_modules")
}

model Question {
  id                 String           @id @default(uuid())
  moduleId           String           @map("module_id")
  module             DiagnosticModule @relation(fields: [moduleId], references: [id])
  order              Int
  type               QuestionType
  textEs             String           @map("text_es")
  contextEs          String?          @map("context_es")
  isConsistencyCheck Boolean          @default(false) @map("is_consistency_check")
  maxSelections      Int?             @map("max_selections")
  scaleType          ScaleType?       @map("scale_type")
  reasonPromptEs     String?          @map("reason_prompt_es")
  reasonThreshold    Int?             @map("reason_threshold")
  options            AnswerOption[]
  responses          Response[]

  @@index([moduleId])
  @@map("questions")
}

model AnswerOption {
  id          String     @id @default(uuid())
  questionId  String     @map("question_id")
  question    Question   @relation(fields: [questionId], references: [id])
  order       Int
  textEs      String     @map("text_es")
  value       String
  scoreDeltas Json       @map("score_deltas")
  flags       String[]
  tags        String[]
  responses   Response[]

  @@index([questionId])
  @@map("answer_options")
}

model DiagnosticSession {
  id              String             @id @default(uuid())
  userId          String             @unique @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId       String             @map("version_id")
  version         DiagnosticVersion  @relation(fields: [versionId], references: [id])
  currentPhase    DiagnosticPhase    @default(FASE1) @map("current_phase")
  currentModuleId String?            @map("current_module_id")
  startedAt       DateTime           @default(now()) @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  lastActivityAt  DateTime           @default(now()) @map("last_activity_at")
  metadata        Json?
  responses       Response[]
  moduleProgress  UserModuleProgress[]
  snapshots       ScoreSnapshot[]
  alerts          AdminAlert[]
  events          DiagnosticEvent[]
  discoveries     Discovery[]
  seeds           RecommendationSeed[]
  profile         MasterProfile?

  @@map("diagnostic_sessions")
}

model UserModuleProgress {
  id          String           @id @default(uuid())
  sessionId   String           @map("session_id")
  session     DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId    String           @map("module_id")
  module      DiagnosticModule @relation(fields: [moduleId], references: [id])
  status      ModuleStatus     @default(LOCKED)
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  outroSeen   Boolean          @default(false) @map("outro_seen")
  outroText   String?          @map("outro_text")

  @@unique([sessionId, moduleId])
  @@map("user_module_progress")
}

model Response {
  id                String            @id @default(uuid())
  sessionId         String            @map("session_id")
  session           DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId        String            @map("question_id")
  question          Question          @relation(fields: [questionId], references: [id])
  selectedOptionIds String[]          @map("selected_option_ids")
  selectedOptions   AnswerOption[]
  freeText          String?           @map("free_text")
  rankingOrder      String[]          @map("ranking_order")
  answeredAt        DateTime          @default(now()) @map("answered_at")
  latencyMs         Int?              @map("latency_ms")
  editCount         Int               @default(0) @map("edit_count")

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("responses")
}

model ScoreSnapshot {
  id            String            @id @default(uuid())
  sessionId     String            @map("session_id")
  session       DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggeredBy   String            @map("triggered_by")
  scores        Json
  subscores     Json
  indices       Json
  confidence    Json
  completionPct Float             @map("completion_pct")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("score_snapshots")
}

model Rule {
  id          String            @id @default(uuid())
  versionId   String            @map("version_id")
  version     DiagnosticVersion @relation(fields: [versionId], references: [id])
  slug        String
  phase       DiagnosticPhase?
  trigger     String
  conditions  Json
  actions     Json
  priority    Int               @default(100)
  isActive    Boolean           @default(true) @map("is_active")
  description String?

  @@unique([versionId, slug])
  @@index([phase])
  @@map("rules")
}

model AdminAlert {
  id             String            @id @default(uuid())
  sessionId      String            @map("session_id")
  session        DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           AlertType
  severity       AlertSeverity
  motivo         String
  evidencia      Json
  accionSugerida String            @map("accion_sugerida")
  isRead         Boolean           @default(false) @map("is_read")
  isActioned     Boolean           @default(false) @map("is_actioned")
  actionNote     String?           @map("action_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  resolvedAt     DateTime?         @map("resolved_at")

  @@index([sessionId])
  @@index([severity])
  @@index([isRead])
  @@map("admin_alerts")
}

model DiagnosticEvent {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  session   DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@map("diagnostic_events")
}

model Discovery {
  id           String            @id @default(uuid())
  sessionId    String            @map("session_id")
  session      DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId     String            @map("module_id")
  dimensionKey String            @map("dimension_key")
  textEs       String            @map("text_es")
  templateSlug String            @map("template_slug")
  seenAt       DateTime?         @map("seen_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("discoveries")
}

model Achievement {
  id              String            @id @default(uuid())
  slug            String            @unique
  titleEs         String            @map("title_es")
  descriptionEs   String            @map("description_es")
  iconKey         String?           @map("icon_key")
  unlockCondition Json              @map("unlock_condition")
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model MasterProfile {
  id                 String            @id @default(uuid())
  userId             String            @unique @map("user_id")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String            @unique @map("session_id")
  session            DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version            Int               @default(1)
  archetypePrimary   String            @map("archetype_primary")
  archetypeSecondary String?           @map("archetype_secondary")
  strengths          Json
  weaknesses         Json
  risks              Json
  potentials         Json
  bottlenecks        Json
  priorities         Json
  scores             Json
  indices            Json
  segmentTags        String[]          @map("segment_tags")
  recommendationSeeds Json             @map("recommendation_seeds")
  generatedAt        DateTime          @default(now()) @map("generated_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("master_profiles")
}

model RecommendationSeed {
  id           String            @id @default(uuid())
  sessionId    String            @map("session_id")
  session      DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category     String
  dimensionKey String            @map("dimension_key")
  priority     Int
  payload      Json
  consumed     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("recommendation_seeds")
}

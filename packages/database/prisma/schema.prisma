generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role                 @default(USER)
  onboardingStep      String               @default("TERMS_PENDING") @map("onboarding_step")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  diagnosticSessions  DiagnosticSession[]
  masterProfiles      MasterProfile[]
  purposeRevisions    PurposeRevision[]
  personalPlans       PersonalPlan[]
  planTransitions     PlanTransition[]
  planProposals       PlanProposal[]
  planEvidence        PlanEvidence[]
  weekReviews         WeekReview[]
  guidanceRequests    GuidanceRequest[]
  clarifications      MemberClarification[]
  coreReadings        CoreReading[]
  measurements        QuestionnaireMeasurement[]
  priorityDecisions   PriorityDecision[]
  depthConfirmations  DepthConfirmation[]
  accompanimentDecisions AccompanimentDecision[]
  ikigaiExperiments   IkigaiExperiment[]
  questionnaireAlerts QuestionnaireAlert[]

  @@map("users")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  mpCustomerId       String?            @map("mp_customer_id")
  mpSubscriptionId   String?            @map("mp_subscription_id")
  status             SubscriptionStatus @default(TRIAL)
  trialEnd           DateTime?          @map("trial_end")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Plan {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  periodMonths      Int      @map("period_months")
  priceAmount       Int      @map("price_amount")
  currency          String   @default("CLP")
  discountPct       Int?     @map("discount_pct")
  conditions        String?
  benefits          Json
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  highlightLabel    String?  @map("highlight_label")
  promoText         String?  @map("promo_text")
  trialDaysOverride Int?     @map("trial_days_override")
  autoRenews        Boolean  @default(true) @map("auto_renews")
  providerId        String?  @map("provider_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model BillingSettings {
  id        String   @id @default(uuid())
  trialDays Int      @default(30) @map("trial_days")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("billing_settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Lead {
  id        String   @id @default(uuid())
  email     String
  name      String?
  message   String?
  source    String?  @default("contact")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── DIAGNÓSTICO MAESTRO ───────────────────────────────────────────────────────

enum DiagnosticPhase {
  FASE1
  FASE2
  FASE3
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SCALE_1_5
  FREE_TEXT
  RANKING
}

enum ScaleType {
  BEHAVIORAL
  FREQUENCY
}

enum ModuleStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETE
}

enum DiagnosticSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model DiagnosticVersion {
  id              String             @id @default(uuid())
  version         String             @unique
  isActive        Boolean            @default(false) @map("is_active")
  publishedAt     DateTime?          @map("published_at")
  definitionRef   String?            @map("definition_ref")
  definitionSha256 String?           @map("definition_sha256")
  createdAt       DateTime           @default(now()) @map("created_at")
  modules         DiagnosticModule[]
  sessions        DiagnosticSession[]

  @@map("diagnostic_versions")
}

model DiagnosticModule {
  id               String              @id @default(uuid())
  versionId        String              @map("version_id")
  version          DiagnosticVersion   @relation(fields: [versionId], references: [id])
  phase            DiagnosticPhase
  dimensionKey     String              @map("dimension_key")
  slug             String
  order            Int
  titleEs          String              @map("title_es")
  introEs          String              @map("intro_es")
  outroTemplateEs  String              @map("outro_template_es")
  iconKey          String?             @map("icon_key")
  estimatedMinutes Int                 @map("estimated_minutes")
  isConditional    Boolean             @default(false) @map("is_conditional")
  questions        Question[]
  moduleProgress   UserModuleProgress[]

  @@unique([versionId, slug])
  @@index([phase])
  @@map("diagnostic_modules")
}

model Question {
  id                 String           @id @default(uuid())
  moduleId           String           @map("module_id")
  module             DiagnosticModule @relation(fields: [moduleId], references: [id])
  order              Int
  type               QuestionType
  textEs             String           @map("text_es")
  contextEs          String?          @map("context_es")
  isConsistencyCheck Boolean          @default(false) @map("is_consistency_check")
  maxSelections      Int?             @map("max_selections")
  scaleType          ScaleType?       @map("scale_type")
  reasonPromptEs     String?          @map("reason_prompt_es")
  reasonThreshold    Int?             @map("reason_threshold")
  sourceRef          String?          @map("source_ref")
  instrument         String?
  polarity           String?
  allowedExceptions  String[]         @default([]) @map("allowed_exceptions")
  options            AnswerOption[]
  responses          Response[]

  @@index([moduleId])
  @@map("questions")
}

model AnswerOption {
  id          String     @id @default(uuid())
  questionId  String     @map("question_id")
  question    Question   @relation(fields: [questionId], references: [id])
  order       Int
  textEs      String     @map("text_es")
  value       String
  scoreDeltas Json       @map("score_deltas")
  flags       String[]
  tags        String[]
  responses   Response[]

  @@index([questionId])
  @@map("answer_options")
}

model DiagnosticSession {
  id              String                   @id @default(uuid())
  userId          String                   @map("user_id")
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId       String                   @map("version_id")
  version         DiagnosticVersion        @relation(fields: [versionId], references: [id])
  status          DiagnosticSessionStatus  @default(ACTIVE)
  currentPhase    DiagnosticPhase          @default(FASE1) @map("current_phase")
  currentModuleId String?                  @map("current_module_id")
  startedAt       DateTime                 @default(now()) @map("started_at")
  completedAt     DateTime?                @map("completed_at")
  lastActivityAt  DateTime                 @default(now()) @map("last_activity_at")
  metadata        Json?
  responses       Response[]
  moduleProgress  UserModuleProgress[]
  snapshots       ScoreSnapshot[]
  events          DiagnosticEvent[]
  profile         MasterProfile?
  formResults     DiagnosticFormResult[]
  questionnaireAlerts QuestionnaireAlert[]

  @@index([userId, status])
  @@map("diagnostic_sessions")
}

model UserModuleProgress {
  id          String           @id @default(uuid())
  sessionId   String           @map("session_id")
  session     DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId    String           @map("module_id")
  module      DiagnosticModule @relation(fields: [moduleId], references: [id])
  status      ModuleStatus     @default(LOCKED)
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  outroSeen   Boolean          @default(false) @map("outro_seen")
  outroText   String?          @map("outro_text")

  @@unique([sessionId, moduleId])
  @@map("user_module_progress")
}

model Response {
  id                String            @id @default(uuid())
  sessionId         String            @map("session_id")
  session           DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId        String            @map("question_id")
  question          Question          @relation(fields: [questionId], references: [id])
  selectedOptionIds String[]          @map("selected_option_ids")
  selectedOptions   AnswerOption[]
  freeText          String?           @map("free_text")
  rankingOrder      String[]          @map("ranking_order")
  answeredAt        DateTime          @default(now()) @map("answered_at")
  latencyMs         Int?              @map("latency_ms")
  editCount         Int               @default(0) @map("edit_count")
  skipped           Boolean           @default(false)
  exceptionKind     String?           @map("exception_kind")
  exceptionOrigin   String?           @map("exception_origin")
  revision          Int               @default(0)
  revisions         ResponseRevision[]

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("responses")
}

model ResponseRevision {
  id                String   @id @default(uuid())
  responseId        String   @map("response_id")
  response          Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  revision          Int
  freeText          String?  @map("free_text")
  selectedOptionIds String[] @map("selected_option_ids")
  exceptionKind     String?  @map("exception_kind")
  exceptionOrigin   String?  @map("exception_origin")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([responseId, revision])
  @@map("response_revisions")
}

model ScoreSnapshot {
  id            String            @id @default(uuid())
  sessionId     String            @map("session_id")
  session       DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggeredBy   String            @map("triggered_by")
  scores        Json
  subscores     Json
  indices       Json
  confidence    Json
  completionPct Float             @map("completion_pct")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("score_snapshots")
}

model DiagnosticEvent {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  session   DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@map("diagnostic_events")
}

model MasterProfile {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String            @unique @map("session_id")
  session            DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isCurrent          Boolean           @default(false) @map("is_current")
  version            Int               @default(1)
  archetypePrimary   String            @map("archetype_primary")
  archetypeSecondary String?           @map("archetype_secondary")
  strengths          Json
  weaknesses         Json
  risks              Json
  potentials         Json
  bottlenecks        Json
  priorities         Json
  scores             Json
  indices            Json
  segmentTags        String[]          @map("segment_tags")
  recommendationSeeds Json             @map("recommendation_seeds")
  generatedAt        DateTime          @default(now()) @map("generated_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([userId, isCurrent])
  @@map("master_profiles")
}

enum LabDefinitionStatus {
  CANDIDATE
  ACCEPTED_CANDIDATE
  REJECTED
  PUBLISHED
}

enum LabCaseKind {
  REAL
  SYNTHETIC
  SELF
  IMPORTED
  SIMULATION
}

enum LabRunKind {
  ORIGINAL
  POLICY
  REPLAY
  WHAT_IF
}

enum LabRunStatus {
  COLLECTING
  AWAITING_EXPECTATION
  REVEALED
  FAILED
}

enum LabChangeSetStatus {
  OPEN
  MATERIALIZED
  REPLAYED
  ACCEPTED
  REJECTED
}

enum ExperienceDefinitionStatus {
  CANDIDATE
  ACCEPTED_CANDIDATE
  REJECTED
  PUBLISHED
}

model LabDefinition {
  id                 String              @id @default(uuid())
  definitionId       String              @map("definition_id")
  revision           Int
  definitionRef      String              @unique @map("definition_ref")
  definitionSha256   String              @map("definition_sha256")
  sourceSha256       String              @map("source_sha256")
  status             LabDefinitionStatus
  payload            Json
  baseDefinitionRef  String?             @map("base_definition_ref")
  changesetId        String?             @map("changeset_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  runs               LabRun[]
  workspaces         LabDefinitionWorkspace[] @relation("WorkspaceBase")
  changeSetsAsBase   LabChangeSet[]      @relation("ChangeSetBase")
  changeSetsAsTarget LabChangeSet[]      @relation("ChangeSetTarget")

  @@unique([definitionId, revision])
  @@index([definitionSha256])
  @@map("lab_definitions")
}

model LabDefinitionWorkspace {
  id                String         @id @default(uuid())
  baseDefinitionRef String         @map("base_definition_ref")
  base              LabDefinition  @relation("WorkspaceBase", fields: [baseDefinitionRef], references: [definitionRef])
  pendingOperations Json           @default("[]") @map("pending_operations")
  createdBy         String         @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  changeSets        LabChangeSet[]

  @@map("lab_definition_workspaces")
}

model LabChangeSet {
  id                    String             @id @default(uuid())
  number                Int
  workspaceId           String             @map("workspace_id")
  workspace             LabDefinitionWorkspace @relation(fields: [workspaceId], references: [id])
  baseDefinitionRef     String             @map("base_definition_ref")
  base                  LabDefinition      @relation("ChangeSetBase", fields: [baseDefinitionRef], references: [definitionRef])
  baseDefinitionSha256  String             @map("base_definition_sha256")
  targetDefinitionRef   String?            @unique @map("target_definition_ref")
  target                LabDefinition?     @relation("ChangeSetTarget", fields: [targetDefinitionRef], references: [definitionRef])
  targetDefinitionSha256 String?           @map("target_definition_sha256")
  operations            Json
  reason                String
  relatedCaseIds        String[]           @map("related_case_ids")
  relatedRunIds         String[]           @map("related_run_ids")
  relatedReviewIds      String[]           @map("related_review_ids")
  findingId             String?            @map("finding_id")
  finding               LabFinding?        @relation(fields: [findingId], references: [id])
  unmotivated           Boolean            @default(false)
  status                LabChangeSetStatus @default(OPEN)
  createdBy             String             @map("created_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  replays               LabReplayRun[]

  @@map("lab_changesets")
}

model LabCase {
  id                String      @id @default(uuid())
  label             String
  kind              LabCaseKind
  blind             Boolean     @default(true)
  expertContext     String?     @map("expert_context")
  fixtureKey        String?     @map("fixture_key")
  casebookKey       String?     @map("casebook_key")
  derivedFromCaseId String?     @map("derived_from_case_id")
  derivedFrom       LabCase?    @relation("CaseDerivation", fields: [derivedFromCaseId], references: [id])
  derivedCases      LabCase[]   @relation("CaseDerivation")
  createdBy         String      @map("created_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  archivedAt        DateTime?   @map("archived_at")
  runs              LabRun[]
  directions        DirectionVersion[]
  productReviews    ProductReview[]
  findings          LabFindingCase[]
  observations      LabQuestionObservation[]

  @@index([kind])
  @@index([derivedFromCaseId])
  @@map("lab_cases")
}

model LabRun {
  id                String       @id @default(uuid())
  caseId            String       @map("case_id")
  case              LabCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind              LabRunKind   @default(ORIGINAL)
  sourceRunId       String?      @map("source_run_id")
  definitionRef     String       @map("definition_ref")
  definition        LabDefinition @relation(fields: [definitionRef], references: [definitionRef])
  definitionSha256  String       @map("definition_sha256")
  sourceSha256      String       @map("source_sha256")
  engineSemver      String       @map("engine_semver")
  policyId          String       @map("policy_id")
  status            LabRunStatus @default(COLLECTING)
  responsesHash     String?      @map("responses_hash")
  snapshot          Json?
  frozenAt          DateTime?    @map("frozen_at")
  revealedAt        DateTime?    @map("revealed_at")
  skippedExpectation Boolean     @default(false) @map("skipped_expectation")
  startedAt         DateTime     @default(now()) @map("started_at")
  directionReading  Json?        @map("direction_reading")
  directionMethodologyVersion String? @map("direction_methodology_version")
  responses         LabResponse[]
  expectations      LabExpectation[]
  reviews           LabReview[]
  safetyAssessments LabSafetyAssessment[]
  purposeAssessments LabExpertPurposeAssessment[]
  projections       ExperienceProjectionRecord[]
  replayResults     LabReplayResult[]
  observations      LabQuestionObservation[]

  @@index([caseId])
  @@index([definitionRef])
  @@map("lab_runs")
}

model LabResponse {
  id                    String   @id @default(uuid())
  runId                 String   @map("run_id")
  run                   LabRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  questionId            String   @map("question_id")
  status                String
  rawValue              String?  @map("raw_value")
  valueKind             String   @map("value_kind")
  qualitativeConfirmed  Boolean? @map("qualitative_confirmed")
  source                String
  answeredAt            DateTime @default(now()) @map("answered_at")
  latencyMs             Int?     @map("latency_ms")

  @@unique([runId, questionId])
  @@map("lab_responses")
}

model LabExpectation {
  id                     String   @id @default(uuid())
  runId                  String   @map("run_id")
  run                    LabRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  revision               Int
  expectedStates         Json     @map("expected_states")
  expectedPriorityDomain String   @map("expected_priority_domain")
  expectedPlanId         String?  @map("expected_plan_id")
  expectedPlanFreeText   String?  @map("expected_plan_free_text")
  expectedAlerts         String[] @map("expected_alerts")
  expectedPurposeStage   String   @map("expected_purpose_stage")
  confidence             String
  notes                  String?
  // LAB-ONLY open reading captured before the MK categories. Never reaches the engine,
  // never enters the definition, never changes a snapshot.
  openWhatIsHappening    String?  @map("open_what_is_happening")
  openMainConcern        String?  @map("open_main_concern")
  openFirstFocus         String?  @map("open_first_focus")
  openFirstAction        String?  @map("open_first_action")
  // Structured personal decision. LAB ONLY. Not the Matrix prediction.
  personalFirstDomain    String?  @map("personal_first_domain")
  submittedAt            DateTime @default(now()) @map("submitted_at")
  submittedBy            String   @map("submitted_by")

  @@unique([runId, revision])
  @@map("lab_expectations")
}

model LabReview {
  id                      String   @id @default(uuid())
  runId                   String   @map("run_id")
  run                     LabRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  revision                Int
  verdicts                Json
  firstWrongLayer         String?  @map("first_wrong_layer")
  rootCauseCodes          String[] @map("root_cause_codes")
  // LAB-ONLY: responses Rafa considered decisive. Not read by the engine.
  evidenceRefs            String[] @default([]) @map("evidence_refs")
  notes                   String?
  recommendedPlanId       String?  @map("recommended_plan_id")
  postRevealStates        Json?    @map("post_reveal_states")
  postRevealPriorityDomain String? @map("post_reveal_priority_domain")
  noMethodologicalProblem Boolean  @default(false) @map("no_methodological_problem")
  caseVerdict             String?  @map("case_verdict")
  familyVerdicts          Json     @default("{}") @map("family_verdicts")
  hypothesis              String?
  disposition             String?
  linkedFindingId         String?  @map("linked_finding_id")
  doubtedRules            String[] @default([]) @map("doubted_rules")
  submittedAt             DateTime @default(now()) @map("submitted_at")
  submittedBy             String   @map("submitted_by")

  @@unique([runId, revision])
  @@map("lab_reviews")
}

model LabSafetyAssessment {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  run         LabRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  questionId  String   @map("question_id")
  verdict     String
  notes       String?
  submittedAt DateTime @default(now()) @map("submitted_at")
  submittedBy String   @map("submitted_by")

  @@index([runId, questionId])
  @@map("lab_safety_assessments")
}

model LabExpertPurposeAssessment {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  run         LabRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  revision    Int
  stage       String
  evidenceRefs String[] @map("evidence_refs")
  confidence  String
  notes       String?
  submittedAt DateTime @default(now()) @map("submitted_at")
  submittedBy String   @map("submitted_by")

  @@unique([runId, revision])
  @@map("lab_expert_purpose_assessments")
}

model LabReplayRun {
  id                   String        @id @default(uuid())
  changesetId          String        @map("changeset_id")
  changeset            LabChangeSet  @relation(fields: [changesetId], references: [id])
  baseDefinitionRef    String        @map("base_definition_ref")
  candidateDefinitionRef String      @map("candidate_definition_ref")
  status               String        @default("COMPLETE")
  createdBy            String        @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at")
  results              LabReplayResult[]

  @@map("lab_replay_runs")
}

model LabReplayResult {
  id                String       @id @default(uuid())
  replayRunId       String       @map("replay_run_id")
  replay            LabReplayRun @relation(fields: [replayRunId], references: [id], onDelete: Cascade)
  sourceRunId       String       @map("source_run_id")
  sourceRun         LabRun       @relation(fields: [sourceRunId], references: [id])
  baseSnapshot      Json         @map("base_snapshot")
  candidateSnapshot Json         @map("candidate_snapshot")
  flags             Json
  attribution       String
  verdict           String?
  verdictBy         String?      @map("verdict_by")
  verdictAt         DateTime?    @map("verdict_at")

  @@unique([replayRunId, sourceRunId])
  @@map("lab_replay_results")
}

model ExperienceDefinition {
  id             String                     @id @default(uuid())
  experienceId   String                     @map("experience_id")
  revision       Int
  experienceRef  String                     @unique @map("experience_ref")
  sha256         String
  status         ExperienceDefinitionStatus
  payload        Json
  createdAt      DateTime                   @default(now()) @map("created_at")
  projections    ExperienceProjectionRecord[]

  @@unique([experienceId, revision])
  @@map("experience_definitions")
}

model DirectionVersion {
  id            String   @id @default(uuid())
  caseId        String   @map("case_id")
  case          LabCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  revision      Int
  statement     String
  status        String
  evidenceRefs  String[] @map("evidence_refs")
  confidence    String?
  source        String
  supersedesId  String?  @map("supersedes_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([caseId, revision])
  @@map("direction_versions")
}

model ExperienceProjectionRecord {
  id                    String               @id @default(uuid())
  runId                 String               @map("run_id")
  run                   LabRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  experienceRef         String               @map("experience_ref")
  experience            ExperienceDefinition @relation(fields: [experienceRef], references: [experienceRef])
  experienceSha256      String               @map("experience_sha256")
  projection            Json
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([runId])
  @@map("experience_projection_records")
}

model ProductReview {
  id                    String   @id @default(uuid())
  caseId                String   @map("case_id")
  case                  LabCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  runId                 String   @map("run_id")
  revision              Int
  verdicts              Json
  purposeFeels          String   @map("purpose_feels")
  stillMk               String   @map("still_mk")
  firstProductDivergence String  @map("first_product_divergence")
  whatWouldChange       String?  @map("what_would_change")
  whatWasMissing        String?  @map("what_was_missing")
  submittedAt           DateTime @default(now()) @map("submitted_at")
  submittedBy           String   @map("submitted_by")

  @@unique([runId, revision])
  @@map("product_reviews")
}

model LabFinding {
  id                   String   @id @default(uuid())
  number               Int      @unique
  title                String
  summary              String
  layer                String
  severity             String
  status               String
  hypothesis           String?
  currentBehavior      String   @map("current_behavior")
  rafaExpectedBehavior String   @map("rafa_expected_behavior")
  relatedRules         String[] @map("related_rules")
  evidenceIds          String[] @map("evidence_ids")
  decision             String?
  decisionReason       String?  @map("decision_reason")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  contentChangeRequired Boolean  @default(false) @map("content_change_required")
  cases                 LabFindingCase[]
  changeSets            LabChangeSet[]
  consistencies         LabFindingConsistency[]
  observations          LabQuestionObservation[]

  @@map("lab_findings")
}

model LabQuestionObservation {
  id         String      @id @default(uuid())
  questionId String      @map("question_id")
  caseId     String?     @map("case_id")
  case       LabCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  runId      String?     @map("run_id")
  run        LabRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewer   String
  issueTypes String[]    @map("issue_types")
  note       String
  proposal   String?
  aspects    Json?
  proposedWording String? @map("proposed_wording")
  kind       String      @default("CONTENT")
  suggestedOperation Json? @map("suggested_operation")
  fidelity   Json?
  status     String      @default("PENDING")
  findingId  String?     @map("finding_id")
  finding    LabFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([questionId])
  @@index([caseId])
  @@index([findingId])
  @@map("lab_question_observations")
}

model LabFindingCase {
  findingId       String     @map("finding_id")
  caseId          String     @map("case_id")
  finding         LabFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  case            LabCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  supportsFinding String?    @map("supports_finding")
  rafaCriterion   String?    @map("rafa_criterion")
  matrixResult    String?    @map("matrix_result")
  difference      String?

  @@id([findingId, caseId])
  @@map("lab_finding_cases")
}

model LabFindingConsistency {
  id               String     @id @default(uuid())
  findingId        String     @map("finding_id")
  finding          LabFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  acceptedCaseKey  String     @map("accepted_case_key")
  rejectedCaseKey  String     @map("rejected_case_key")
  answer           String?
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("lab_finding_consistencies")
}

model LabWorkSession {
  id                             String    @id @default(uuid())
  title                          String    @default("Sesión con Rafa")
  casebookKeys                   String[]  @map("casebook_keys")
  closeObservationBeforeChanges  Boolean   @default(true) @map("close_observation_before_changes")
  createdBy                      String    @map("created_by")
  createdAt                      DateTime  @default(now()) @map("created_at")
  closedAt                       DateTime? @map("closed_at")
  summary                        Json?

  @@index([createdBy, closedAt])
  @@map("lab_work_sessions")
}

model LabMigrationDecision {
  id          String   @id
  rafaVerdict String?  @map("rafa_verdict")
  rafaNote    String?  @map("rafa_note")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("lab_migration_decisions")
}

model LabReadinessDecision {
  id            String   @id @default(uuid())
  candidateRef  String   @map("candidate_ref")
  decision      String
  note          String?
  decidedBy     String   @map("decided_by")
  decidedAt     DateTime @default(now()) @map("decided_at")

  @@map("lab_readiness_decisions")
}

enum IkigaiDefinitionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum IkigaiSessionStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  FOLLOW_UP
  ARCHIVED
}

model IkigaiDefinition {
  id           String                 @id @default(uuid())
  definitionId String                 @map("definition_id")
  revision     Int
  ref          String                 @unique
  status       IkigaiDefinitionStatus @default(DRAFT)
  sha256       String
  engineMin    String                 @map("engine_min")
  payload      Json
  publishedAt  DateTime?              @map("published_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  sessions     IkigaiSession[]

  @@unique([definitionId, revision])
  @@index([status])
  @@map("ikigai_definitions")
}

model IkigaiSession {
  id             String              @id @default(uuid())
  definitionId   String              @map("definition_id")
  definition     IkigaiDefinition    @relation(fields: [definitionId], references: [id])
  tokenHash      String?             @unique @map("token_hash")
  status         IkigaiSessionStatus @default(NEW)
  currentStep    String              @default("PASION") @map("current_step")
  draftVersion   Int                 @default(0) @map("draft_version")
  draft          Json
  source         Json?
  startedAt      DateTime            @default(now()) @map("started_at")
  lastActivityAt DateTime            @default(now()) @map("last_activity_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  snapshots      IkigaiResultSnapshot[]

  @@index([status, lastActivityAt])
  @@index([definitionId])
  @@map("ikigai_sessions")
}

model IkigaiResultSnapshot {
  id            String        @id @default(uuid())
  sessionId     String        @map("session_id")
  session       IkigaiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  revision      Int
  definitionRef String        @map("definition_ref")
  engineVersion String        @map("engine_version")
  sha256        String
  payload       Json
  createdAt     DateTime      @default(now()) @map("created_at")

  @@unique([sessionId, revision])
  @@map("ikigai_result_snapshots")
}

/// One firing of a questionnaire rule. The key is per account, not global.
model QuestionnaireAlert {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String            @map("session_id")
  session          DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  occurrenceKey    String            @unique @map("occurrence_key")
  questionRef      String            @map("question_ref")
  ruleVersion      String            @map("rule_version")
  nativeRule       String            @map("native_rule")
  productRule      String            @map("product_rule")
  responseRevision Int               @map("response_revision")
  responseValue    String?           @map("response_value")
  catalogVersion   String            @map("catalog_version")
  moduleSlug       String?           @map("module_slug")
  answeredAt       DateTime?         @map("answered_at")
  detectedAt       DateTime          @default(now()) @map("detected_at")
  provenance       String

  @@index([userId, sessionId, detectedAt])
  @@index([questionRef])
  @@map("questionnaire_alerts")
}

/// Who opened a member record. No answer text, token or signature.
model AdminAccessLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  targetUserId String   @map("target_user_id")
  resource     String
  resourceId   String?  @map("resource_id")
  requestId    String   @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_access_logs")
}

model DiagnosticFormResult {
  id         String            @id @default(uuid())
  sessionId  String            @map("session_id")
  session    DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  formCode   String            @map("form_code")
  payload    Json
  computedAt DateTime          @default(now()) @map("computed_at")

  @@unique([sessionId, formCode])
  @@map("diagnostic_form_results")
}

model PurposeRevision {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?   @map("session_id")
  revision    Int
  content     Json
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, revision])
  @@map("purpose_revisions")
}

enum PersonalPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ActionRecordStatus {
  PENDING
  DONE
  SKIPPED
  NOT_APPLICABLE
}

enum ActionDomain {
  MENTE
  ESPIRITU
  CUERPO
}

/// Dated operational clarification. It does not rewrite questionnaire answers.
model MemberClarification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  outcome   String
  /// Null on rows written before subject-scoped clarifications. Do not guess a subject.
  subjectRef   String?  @map("subject_ref")
  detail       String?
  source       String?
  rulesVersion String?  @map("rules_version")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, scope, createdAt])
  @@map("member_clarifications")
}

model PersonalPlan {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  outcome      String
  priorityNote String?            @map("priority_note")
  /// DIRECT, ENABLING, PROTECTIVE or EXPLORATORY. The note is the artifact, not the link.
  linkKind     String?            @map("link_kind")
  /// Value or standard the person chose for this plan. It does not score the plan.
  valueRef     String?            @map("value_ref")
  /// Purpose revision that was current when the plan was written.
  purposeRevisionId String?       @map("purpose_revision_id")
  /// IKIGAI combination this plan is testing, when it came from the cross.
  sourceCombinationId String?     @map("source_combination_id")
  status       PersonalPlanStatus @default(DRAFT)
  /// PREPARING, ACTIVE, PAUSED, MAINTENANCE, CLOSED. Null rows use status via fromLegacy.
  stage        String?            @map("stage")
  goalClass    String?            @map("goal_class")
  entry        String?            @map("entry")
  territory    String?            @map("territory")
  whyItMatters String?            @map("why_it_matters")
  whyStatus    String?            @map("why_status")
  whyRefs      Json?              @map("why_refs")
  linkStatus   String?            @map("link_status")
  baseline     String?            @map("baseline")
  criterionText String?           @map("criterion_text")
  criterionStatus String?          @map("criterion_status")
  criterionRevision Int?          @map("criterion_revision")
  reviewAt     DateTime?          @map("review_at") @db.Date
  expectedSignal String?          @map("expected_signal")
  capacityMinutes Int?            @map("capacity_minutes")
  protectNote  String?            @map("protect_note")
  activatedAt  DateTime?          @map("activated_at")
  achievedAt   DateTime?          @map("achieved_at")
  closedReason String?            @map("closed_reason")
  isFocus      Boolean            @default(false) @map("is_focus")
  focusSince   DateTime?          @map("focus_since")
  version      Int                @default(1) @map("version")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  actions      PlanAction[]
  transitions  PlanTransition[]
  proposals    PlanProposal[]
  evidence     PlanEvidence[]

  @@index([userId, status])
  @@map("personal_plans")
}

model PlanTransition {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String       @map("plan_id")
  plan          PersonalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromStage     String?      @map("from_stage")
  toStage       String       @map("to_stage")
  reason        String?      @map("reason")
  effectiveFrom DateTime?    @map("effective_from") @db.Date
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([planId, createdAt])
  @@index([userId, createdAt])
  @@map("plan_transitions")
}

model PlanAction {
  id           String     @id @default(uuid())
  planId       String     @map("plan_id")
  plan         PersonalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title        String
  doneWhen     String     @map("done_when")
  domain       ActionDomain?
  weekday      Int?
  /// Days between occasions. 7 is weekly. A later review can raise it without rewriting past records.
  intervalDays Int        @default(7) @map("interval_days")
  pausedAt     DateTime?  @map("paused_at")
  /// The earlier action this one replaced. Records stay on the earlier action.
  replacesActionId String? @map("replaces_action_id")
  /// What to prepare before the occasion. Does not score alignment.
  preparation  String?
  /// Published territory. domain stays the pillar.
  territory    String?
  effectiveFrom String? @map("effective_from")
  /// Marks the member declared for this action. Empty means they declared none.
  contentTags  String[]   @default([]) @map("content_tags")
  /// VIABLE when this action was declared a confrontation the member can hold. Null otherwise.
  conversationOutcome String? @map("conversation_outcome")
  /// Null means the origin was not recorded. Do not backfill MEMBER or SYSTEM_TEMPLATE.
  origin       String?
  decisionId   String?    @map("decision_id")
  familyId     String?    @map("family_id")
  templateVersion String? @map("template_version")
  templateTags String[]   @default([]) @map("template_tags")
  minutesPerOccasion Int? @map("minutes_per_occasion")
  occasionsPerWeek Int?   @map("occasions_per_week")
  minimumVersion String?  @map("minimum_version")
  alternative  String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  records      ActionRecord[]
  cancellations OccasionCancellation[]
  schedules    ActionSchedule[]

  @@index([planId])
  @@map("plan_actions")
}

model ActionSchedule {
  id               String     @id @default(uuid())
  actionId         String     @map("action_id")
  action           PlanAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  effectiveFrom    DateTime   @map("effective_from") @db.Date
  effectiveTo      DateTime?  @map("effective_to") @db.Date
  kind             String
  weekday          Int?
  intervalDays     Int?       @map("interval_days")
  anchorDay        DateTime?  @map("anchor_day") @db.Date
  occasionsPerWeek Int?       @map("occasions_per_week")
  source           String
  commandKey       String?    @map("command_key")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([actionId, effectiveFrom])
  @@map("action_schedules")
}

model PlanProposal {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?       @map("plan_id")
  plan           PersonalPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  territory      String?
  kind           String
  payload        Json
  reasons        Json?
  basis          Json?
  status         String        @default("PENDING")
  editedPayload  Json?         @map("edited_payload")
  decidedAt      DateTime?     @map("decided_at")
  engineVersion  String?       @map("engine_version")
  rulesVersion   String?       @map("rules_version")
  templateRef    String?       @map("template_ref")
  digest         String?
  commandKey     String?       @map("command_key")
  supersedesId   String?       @map("supersedes_id")
  effect         Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([userId, commandKey])
  @@index([planId, createdAt])
  @@map("plan_proposals")
}

model PlanEvidence {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String       @map("plan_id")
  plan              PersonalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  criterionRevision Int          @map("criterion_revision")
  observedOn        DateTime     @map("observed_on") @db.Date
  kind              String
  status            String
  text              String?
  actionRecordId    String?      @map("action_record_id")
  source            String       @default("DECLARED_BY_MEMBER")
  commandKey        String?      @map("command_key")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([planId, observedOn])
  @@map("plan_evidence")
}

model ActionRecord {
  id        String             @id @default(uuid())
  actionId  String             @map("action_id")
  action    PlanAction         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  day       String
  status     ActionRecordStatus @default(PENDING)
  note       String?
  /// What was observed. Separate from whether the action was done.
  resultNote String?            @map("result_note")
  /// Null on older rows. A note alone is not an observed result.
  resultStatus String?          @map("result_status")
  revision     Int              @default(0)
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([actionId, day])
  @@map("action_records")
}

model WeekReview {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   String   @map("week_start")
  timezone    String   @default("America/Santiago")
  snapshot    Json
  note        String?
  /// Null on closes written before this contract. Do not invent a digest.
  commandDigest String? @map("command_digest")
  /// False when the row is only a reflection and did not change the plan.
  applied     Boolean  @default(true)
  closedAt    DateTime @default(now()) @map("closed_at")

  @@unique([userId, weekStart])
  @@map("week_reviews")
}

model GuidanceRequest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  note      String?
  status    String   @default("SENT")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("guidance_requests")
}

/// Immutable alignment, reconstruction, remeasure or depth snapshot.
model CoreReading {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              String
  methodVersion     String   @map("method_version")
  definitionSha     String   @map("definition_sha")
  sessionId         String?  @map("session_id")
  measurementId     String?  @map("measurement_id")
  baselineReadingId String?  @map("baseline_reading_id")
  commandKey        String   @unique @map("command_key")
  input             Json
  output            Json
  computedAt        DateTime @default(now()) @map("computed_at")

  @@index([userId, methodVersion, computedAt])
  @@map("core_readings")
}

model QuestionnaireMeasurement {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  status          String
  methodVersion   String                @map("method_version")
  sessionId       String?               @map("session_id")
  commandKey      String                @unique @map("command_key")
  closedAt        DateTime?             @map("closed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  responses       MeasurementResponse[]

  @@index([userId, status])
  @@map("questionnaire_measurements")
}

model MeasurementResponse {
  id            String                   @id @default(uuid())
  measurementId String                   @map("measurement_id")
  measurement   QuestionnaireMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  sourceRef     String                   @map("source_ref")
  value         String?
  exceptionKind String?                  @map("exception_kind")
  revision      Int                      @default(0)
  answeredAt    DateTime?                @map("answered_at")

  @@unique([measurementId, sourceRef])
  @@map("measurement_responses")
}

model PriorityDecision {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  engineVersion String   @map("engine_version")
  readingId     String?  @map("reading_id")
  digest        String
  proposal      Json
  choice        Json
  commandKey    String   @unique @map("command_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("priority_decisions")
}

model PriorityHead {
  userId     String @id @map("user_id")
  decisionId String @map("decision_id")
  version    Int    @default(1)

  @@map("priority_heads")
}

model DepthConfirmation {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  component         String
  payload           Json
  purposeRevisionId String?  @map("purpose_revision_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, component, createdAt])
  @@map("depth_confirmations")
}

/// One row per confirmed or rejected accompaniment. The head points at the principal plan only.
model AccompanimentDecision {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  engineVersion   String   @map("engine_version")
  rulesVersion    String   @map("rules_version")
  catalogVersion  String   @map("catalog_version")
  familyId        String?  @map("family_id")
  templateVersion String?  @map("template_version")
  territory       String?
  pillar          String?
  mode            String?
  modeStatus      String?  @map("mode_status")
  situation       String
  goalText        String?  @map("goal_text")
  goalKind        String?  @map("goal_kind")
  planId          String?  @map("plan_id")
  purposeRevisionId String? @map("purpose_revision_id")
  readingId       String?  @map("reading_id")
  context         Json
  reasons         Json
  help            Json
  digest          String
  canonicalHash   String   @map("canonical_hash")
  status          String
  rejectReason    String?  @map("reject_reason")
  alternativeOf   String?  @map("alternative_of")
  effect          Json?
  /// Unique together with the account. The same text can belong to two people.
  commandKey      String   @map("command_key")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, commandKey])
  @@index([userId, createdAt])
  @@map("accompaniment_decisions")
}

model AccompanimentHead {
  userId     String @id @map("user_id")
  decisionId String @map("decision_id")
  version    Int    @default(1)

  @@map("accompaniment_heads")
}

model OccasionCancellation {
  id            String     @id @default(uuid())
  actionId      String     @map("action_id")
  action        PlanAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  day           String
  reason        String
  source        String
  rulesVersion  String     @map("rules_version")
  effectiveFrom String     @map("effective_from")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@unique([actionId, day])
  @@map("occasion_cancellations")
}

model IkigaiExperiment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String   @map("plan_id")
  combinationId String?  @map("combination_id")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  revisions     IkigaiExperimentRevision[]

  @@index([userId, planId, createdAt])
  @@map("ikigai_experiments")
}

model IkigaiExperimentRevision {
  id                String   @id @default(uuid())
  experimentId      String   @map("experiment_id")
  experiment        IkigaiExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  revision          Int
  hypothesis        String
  sample            String?
  opportunity       String?
  missing           String?
  purposeRevisionId String?  @map("purpose_revision_id")
  createdAt         DateTime @default(now()) @map("created_at")
  observations      ExperimentObservation[]
  reviews           ExperimentReview[]

  @@unique([experimentId, revision])
  @@map("ikigai_experiment_revisions")
}

model ExperimentObservation {
  id             String   @id @default(uuid())
  experimentId   String   @map("experiment_id")
  revisionId     String   @map("revision_id")
  revision       IkigaiExperimentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  aspect         String
  status         String
  recipient      String?
  observed       String?
  source         String   @default("DECLARED_BY_MEMBER")
  actionRecordId String?  @map("action_record_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([experimentId, revisionId])
  @@map("experiment_observations")
}

model ExperimentReview {
  id         String   @id @default(uuid())
  experimentId String @map("experiment_id")
  revisionId String   @map("revision_id")
  revision   IkigaiExperimentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  decision   String
  evidence   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([experimentId, createdAt])
  @@map("experiment_reviews")
}

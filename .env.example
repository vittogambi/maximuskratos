# Copy to apps/api/.env and packages/database/.env (see npm run setup:env)
# Port 5433 = Docker Postgres from docker-compose (not system Postgres on 5432)
DATABASE_URL="postgresql://mk:mk_local_dev@localhost:5433/maximuskratos"
JWT_ACCESS_SECRET="local-dev-access-secret-change-in-production-32chars"
JWT_REFRESH_SECRET="local-dev-refresh-secret-change-in-production-32chars"
CORS_ORIGINS="http://localhost:3000"
NODE_ENV="development"
PORT=4000

# apps/web/.env.local
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Canonical public origin (sitemap, robots, Open Graph, JSON-LD). Prod: https://maximus-kratos.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# apps/api/.env (optional — transactional emails via Resend)
# RESEND_API_KEY="re_..."
# RESEND_FROM="Maximus Kratos <contacto@maximus-kratos.com>"
# WEB_URL="http://localhost:3000"
